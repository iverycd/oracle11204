# Change this before first startup. Do not commit the real .env file.
ORACLE_PWD=Oracle_123
ORACLE_SID=ORCL
ORACLE_MEMORY_MB=2048

IMAGE_NAME=oracle/database:11.2.0.4-ee
CONTAINER_NAME=oracle11204
HOST_PORT=1521
CONTAINER_MEMORY=6g
SHM_SIZE=3g

# bind: data lives under ./oracle_data (this project dir) by default, directly
# browsable on the host. Set DATA_DIR to an absolute path to use somewhere else.
# volume: Docker-managed storage, better I/O on macOS, not directly browsable.
DATA_MODE=bind
VOLUME_NAME=oracle11204-data
# DATA_DIR=/Users/your-name/oracle11204-data
# DATA_MODE=volume
